{
  "name": "financy-server",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "lint": "biome check .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "format": "biome format --write .",
    "precommit": "pnpm lint && pnpm typecheck && pnpm test",
    "dev": "tsx watch --env-file .env.dev src/index.ts",
    "dev:generate": "dotenv -e .env.dev -- prisma generate",
    "dev:migrate": "dotenv -e .env.dev -- prisma migrate dev",
    "dev:seed": "dotenv -e .env.dev -- prisma db seed",
    "dev:db": "pnpm dev:generate && pnpm dev:migrate && pnpm dev:seed",
    "dev:studio": "dotenv -e .env.dev -- prisma studio",
    "test": "dotenv -e .env.test -- vitest run",
    "test:watch": "dotenv -e .env.test -- vitest",
    "test:coverage": "dotenv -e .env.test -- vitest run --coverage",
    "prod:generate": "dotenv -e .env.prod -- prisma generate",
    "prod:migrate": "dotenv -e .env.prod -- prisma migrate deploy",
    "build": "pnpm prod:generate && tsc -p tsconfig.json"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.30.3+sha512.c961d1e0a2d8e354ecaa5166b822516668b7f44cb5bd95122d590dd81922f606f5473b6d23ec4a5be05e7fcd18e8488d47d978bbe981872f1145d06e9a740017",
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/fastify": "^3.1.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^3.0.3",
    "class-validator": "^0.15.1",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "fastify": "^5.8.5",
    "fastify-type-provider-zod": "^6.1.0",
    "graphql": "^16.14.0",
    "jsonwebtoken": "^9.0.3",
    "reflect-metadata": "^0.2.2",
    "type-graphql": "2.0.0-rc.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@faker-js/faker": "^10.4.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.9.1",
    "@vitest/coverage-v8": "^4.1.6",
    "prisma": "^7.8.0",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.6"
  }
}
